DB_HOST=localhost
DB_USER=                # Thay bằng username MySQL của bạn
DB_PASS=                # Thay bằng password MySQL của bạn
DB_NAME=job_portal
ACCESS_TOKEN_SECRET=    # Secret key cho JWT

# Elasticsearch config
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# Worker / Elasticsearch tối ưu khối lượng lớn
CV_WORKER_CONCURRENCY=4
ES_BULK_FLUSH_BYTES=5000000
ES_BULK_CONCURRENCY=5
# Giới hạn đếm total hits (true = chính xác, số = cap, false = nhanh hơn, không chính xác tổng)
ES_SEARCH_TRACK_TOTAL_HITS=10000
ES_SEARCH_TIMEOUT=5s
