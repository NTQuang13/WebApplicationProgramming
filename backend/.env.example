PORT=3000

# Nếu chạy MySQL bằng Docker (docker-compose), DB_HOST là "localhost" nếu chạy node ở máy ngoài, 
# hoặc "db" nếu chạy node trong container.
DB_HOST=localhost
DB_USER= # Tên người dùng MySQL
DB_PASS= # Mật khẩu MySQL
DB_NAME=job_portal
ACCESS_TOKEN_SECRET=    # Secret key cho JWT

# Elasticsearch config
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=gicunđuoc

# Worker / Elasticsearch tối ưu khối lượng lớn
CV_WORKER_CONCURRENCY=4
ES_BULK_FLUSH_BYTES=5000000
ES_BULK_CONCURRENCY=5
# Giới hạn đếm total hits (true = chính xác, số = cap, false = nhanh hơn, không chính xác tổng)
ES_SEARCH_TRACK_TOTAL_HITS=10000
ES_SEARCH_TIMEOUT=5s
